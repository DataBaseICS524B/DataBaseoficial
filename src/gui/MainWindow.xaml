<Window x:Class="CustomDB.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CustomDB.UI.ViewModels"
        mc:Ignorable="d"
        Title="CustomDB — Modern SQL Client"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding ExecuteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Булевый конвертер для видимости -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Стиль для кнопки с акцентом (Execute) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель подключения -->
        <Border Grid.Row="0"
                Background="#2A2A3A"
                CornerRadius="12"
                BorderBrush="#3A3A4A"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Label Content="🌐 Host:" Foreground="#4FC3F7" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" Margin="5,0,15,0"/>
                <Label Content="🔌 Port:" Foreground="#4FC3F7" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Margin="5,0,15,0"/>
                <Button Content="🔗 Connect" Command="{Binding ConnectCommand}"
                        Width="110" IsEnabled="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                <Button Content="⛔ Disconnect" Command="{Binding DisconnectCommand}"
                        Width="110" IsEnabled="{Binding IsConnected}"/>
                <Border Background="#1E1E2E" CornerRadius="20" Padding="12,5" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF5252"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- История запросов -->
        <Border Grid.Row="1"
                Background="#2A2A3A"
                CornerRadius="12"
                BorderBrush="#3A3A4A"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <Label Content="📜 История запросов" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding QueryHistory}"
                          SelectedItem="{Binding SelectedHistoryQuery}"
                          IsEditable="True"
                          Height="32"/>
            </StackPanel>
        </Border>

        <!-- Редактор SQL -->
        <Border Grid.Row="2"
                Background="#2A2A3A"
                CornerRadius="12"
                BorderBrush="#3A3A4A"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <Label Content="✏️ SQL Запрос" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Height="140"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#1E1E2E"
                         Foreground="#F8F8F2"
                         BorderBrush="#3A3A4A"
                         BorderThickness="1"
                         Padding="12,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <Button Content="▶ Выполнить" Command="{Binding ExecuteCommand}"
                            Width="120" Style="{StaticResource AccentButton}"/>
                    <Button Content="🗑 Очистить" Command="{Binding ClearCommand}" Width="100"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Результаты -->
        <Border Grid.Row="3"
                Background="#2A2A3A"
                CornerRadius="12"
                BorderBrush="#3A3A4A"
                BorderThickness="1"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="📊 Результат" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,10"/>

                <ProgressBar Grid.Row="1"
                             Height="3"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Foreground="#4FC3F7"
                             Background="Transparent"
                             Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding QueryResult.ResultData}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MaxHeight="350"
                              BorderBrush="Transparent"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <StatusBar Grid.Row="4" Margin="0,12,0,0" Background="#2A2A3A" BorderBrush="#3A3A4A">
            <StatusBarItem>
                <TextBlock Text="{Binding QueryResult.StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#4FC3F7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QueryResult.HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#FF5252"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="CustomDB v1.0 | Ready" Foreground="#AAAAAA" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
