<Window x:Class="CustomDB.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CustomDB.UI.ViewModels"
        mc:Ignorable="d"
        Title="CustomDB GUI Client" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding ExecuteCommand}"/>
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection panel -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Label Content="Host:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0,10,0"/>
                <Label Content="Port:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5,0,10,0"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}" Width="110" Margin="5"
                        Background="Green" Foreground="White"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="110" Margin="5"
                        Background="Red" Foreground="White"/>
                <Label Content="{Binding ConnectionStatus}" Margin="20,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Query history -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Label Content="Query History:" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding QueryHistory}"
                          SelectedItem="{Binding SelectedHistoryQuery}"
                          IsEditable="True"
                          Height="25"/>
            </StackPanel>
        </Border>

        <!-- SQL editor -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Label Content="SQL Query:" FontWeight="Bold"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Height="150"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderBrush="LightGray"
                         BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="▶ Execute" Command="{Binding ExecuteCommand}" Width="100" Margin="0,0,10,0"
                            Background="DodgerBlue" Foreground="White"/>
                    <Button Content="🗑 Clear" Command="{Binding ClearCommand}" Width="100"
                            Background="Gray" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Result:" FontWeight="Bold"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding QueryResult.ResultData}"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Margin="0,5,0,0"
                          AlternatingRowBackground="LightGray"
                          RowHeaderWidth="0"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding QueryResult.StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QueryResult.HasError}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
